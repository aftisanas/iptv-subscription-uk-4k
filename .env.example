# Shared checkout hub. Leave unset in production — src/lib/constants.ts already
# defaults to https://checkout.british-iptv-4k.com, which is the live hub.
# Override only to point at a local hub while developing.
#NEXT_PUBLIC_CHECKOUT_HUB_URL=http://localhost:3001

# NOTE: this site has no NEXT_PUBLIC_CHECKOUT_MODE switch. The sister project
# (fast-iptv) uses one to send plan clicks straight to WhatsApp instead of to
# /checkout; here the plan cards always route to /checkout, which is equivalent
# to that project running in "hub" mode. There is nothing to configure.
#
# Whether an order reaches Shopify is decided by the HUB, not by this repo:
# the hub must have SITE_SLUG ("iptv-subscription-uk-4k") registered against a
# Shopify store. If it is not registered, /api/availability answers
# {"available":false,"whatsappUrl":""} and every order silently takes the
# WhatsApp path. No environment variable can change that.
